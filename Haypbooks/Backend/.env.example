# ──────────────────────────────────────────────────────────────────────────────
# HaypBooks Backend — environment variables template
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# URL of the Next.js frontend (used in email links and CORS)
FRONTEND_URL=http://localhost:3000

# Enable test/debug endpoints in non-production environments
ALLOW_TEST_ENDPOINTS=true

# Auto-login after email verification link click (dev convenience)
ENABLE_AUTO_VERIFY_LOGIN=false

# Return OTP codes in API responses for local dev/testing ONLY — NEVER set true in production/staging
DEV_SHOW_OTP=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:<your-db-password>@localhost:5432/haypbooks_dev

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be a long, randomly generated secret in production
# Use at least 32 characters for strong signing security
JWT_SECRET=<your-jwt-secret>

# ── Security / HMAC ───────────────────────────────────────────────────────────
# Used to hash phone numbers before storage; must be set in production
HMAC_KEY=<your-hmac-key>

# Used to encrypt sensitive phone fields before storage; must be a 32-byte hex secret (64 hex chars)
FIELD_ENCRYPTION_KEY=<your-field-encryption-key>

# Optional Redis URL for rate limiting / caching
REDIS_URL=

# Cloudflare R2 Storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=haypbooks-uploads

# Allowed origins for browser-based CORS requests. Use a comma-separated list.
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# Comma-separated list of allowed origins for production

# ── Phone / Locale ────────────────────────────────────────────────────────────
# Default country for phone normalisation (ISO 3166-1 alpha-2)
DEFAULT_PHONE_COUNTRY=PH

# ── Email — SendGrid (preferred for production) ───────────────────────────────
# Set SENDGRID_API_KEY to enable SendGrid.  Leave blank to fall through to SMTP.
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@haypbooks.com

# ── AI / Zypra Assistant ──────────────────────────────────────────────────────
# Google Gemini API key for Zypra AI assistant
GEMINI_API_KEY=your_gemini_api_key_here

# ── Email — SMTP (fallback / local dev) ──────────────────────────────────────
# Used when SENDGRID_API_KEY is not set.
# For local dev use MailHog (http://localhost:8025) or Mailtrap.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HaypBooks <noreply@haypbooks.com>

