# HaypBooks Production Environment Template
# Copy this file to .env.production and fill in the real values

NODE_ENV=production

# Security — MUST be false in production
ALLOW_TEST_ENDPOINTS=false
DEV_SHOW_OTP=false

# Security Keys — generate with: openssl rand -hex 32
HMAC_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_KEY
FIELD_ENCRYPTION_KEY=CHANGE_ME_TO_A_32_BYTE_HEX_KEY

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/haypbooks

# JWT — Use strong random secrets in production (generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_STRONG_RANDOM_SECRET

# CORS — Set to your actual frontend URL
CORS_ORIGINS=https://your-domain.com

# Email (SMTP)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=CHANGE_ME

# App
PORT=4000
FRONTEND_URL=https://your-domain.com
